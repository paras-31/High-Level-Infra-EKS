aws_region      = "ap-south-1"
lock_table_name = "terraform-state-lock"

# state_bucket_name is derived from your account at init/plan time in CI.
# For local runs: cp account.config.example account.config, then run scripts/terraform-init.sh bootstrap
# Or set: state_bucket_name = "tf-state-<ACCOUNT_ID>-ap-south-1"

tags = {
  Owner   = "platform-team"
  Project = "eks-platform"
}
